{
  "name": "court-in",
  "version": "1.0.0",
  "private": true,
  "description": "court.in — Modern Sports Court Booking Web Application",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "start": "npm run start -w backend"
  },
  "keywords": [
    "court-booking",
    "sports",
    "react",
    "express",
    "prisma"
  ],
  "author": "Daffa Husen",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
